{
  "name": "clank-talk",
  "version": "0.2.0",
  "description": "A sandboxed, readable scripting language for AI agents, used in place of a shell. Runs as an MCP server.",
  "keywords": ["mcp", "agents", "sandbox", "scripting", "hyperscript", "claude"],
  "homepage": "https://clank.talk",
  "bugs": "https://github.com/bigskysoftware/clank-talk/issues",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigskysoftware/clank-talk.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/js/clank-talk.js",
  "bin": {
    "clank-talk-mcp": "bin/clank-talk-mcp.js"
  },
  "files": [
    "bin/",
    "src/js/"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.js'",
    "build-site": "node docs/build.js",
    "serve-site": "node docs/serve.js",
    "build-coming-soon": "node docs/build.js && cp _site/coming-soon.html _site/index.html"
  },
  "devDependencies": {
    "marked": "^18.1.3"
  }
}
