{
  "comments": { "lineComment": "#" },
  "brackets": [["[", "]"], ["{", "}"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["[", "]"], ["{", "}"], ["(", ")"], ["'", "'"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(if|else|for|repeat|on error|tool|before|after|in .* do)\\b.*$",
    "decreaseIndentPattern": "^\\s*(end|else)\\b"
  }
}
