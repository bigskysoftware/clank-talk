# Tools for agents that work on clank-talk itself
# Commits stay with the human, so there is no git_commit tool.

allow env PATH, HOME

tool run_tests
  run 'npm test'
end

tool git_status
  run 'git status --short --branch'
end

tool git_diff
  run 'git diff'
end

tool git_log
  run 'git log --oneline -15'
end
