# Tools for agents that work on clank-talk itself

allow env PATH, HOME
allow fetch from 'localhost', '127.0.0.1'
allow changes to @/.github/

# Runs the full test suite.
tool run_tests
  run 'npm test' in a sandbox with local network
end

# Starts the docs site at http://localhost:8000/, with live reload.
# Stop it with: stop process 'site'
tool site_server
  start 'npm run serve-site' as 'site' in a sandbox
end
